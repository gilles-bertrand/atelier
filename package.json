{
  "name": "atelier",
  "private": true,
  "version": "0.1.0",
  "description": "Atelier : agent IA local de type Cowork pour macOS (Electron + Ollama distant + VM Lima)",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @atelier/desktop dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern 'qa/**' --max-warnings=0 && eslint qa --max-warnings=0",
    "lint:fix": "eslint . --ignore-pattern 'qa/**' --fix && eslint qa --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "dist:mac": "pnpm fetch:lima && pnpm --filter @atelier/desktop dist",
    "fetch:lima": "node --experimental-strip-types scripts/fetch-lima.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
