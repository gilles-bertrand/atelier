{
  "name": "@atelier/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier : application desktop (Electron main + preload + renderer React).",
  "author": "Triptyk",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.yml",
    "dist:dir": "electron-vite build && electron-builder --mac --arm64 --dir --config electron-builder.yml",
    "icon": "node -e \"require('sharp')('build/icon.svg').resize(1024,1024).png().toFile('build/icon.png')\"",
    "dist:adhoc": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.yml -c.mac.identity=- -c.mac.notarize=false -c.mac.entitlements=build/entitlements.adhoc.plist -c.mac.entitlementsInherit=build/entitlements.adhoc.plist"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.79",
    "@atelier/agent-core": "workspace:*",
    "@atelier/documents": "workspace:*",
    "@atelier/mcp-bridge": "workspace:*",
    "@atelier/sandbox": "workspace:*",
    "@atelier/shared": "workspace:*",
    "@atelier/skills": "workspace:*",
    "@atelier/web": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.154",
    "exceljs": "4.4.0",
    "file-type": "^22.2.0",
    "gray-matter": "^4.0.3",
    "heic-convert": "^2.1.0",
    "jsdom": "^30.1.3",
    "mammoth": "^1.13.0",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "undici": "^8.12.3",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5"
  }
}
