{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/common/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@renderer/*": ["./src/renderer/src/*"] }
  }
}
