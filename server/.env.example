# Copier en .env puis adapter. Ne jamais committer .env.

# Domaine public pointant vers ce serveur (enregistrement DNS A/AAAA).
ATELIER_DOMAIN=llm.example.com
# Email pour Let's Encrypt.
ACME_EMAIL=admin@example.com
# Token partagé avec l'app (Réglages > Serveur). Générer : openssl rand -hex 32
ATELIER_API_TOKEN=change-me
# Requêtes autorisées par minute et par client.
ATELIER_RATE_LIMIT=120

# --- Ollama (voir docs/SERVER.md, section « Variables OLLAMA_* »)
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_NUM_PARALLEL=2
# Modèles gardés chauds. Passer à 2 si plusieurs modèles servent (VRAM cumulée, voir docs/SERVER.md section 5).
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_QUEUE=128
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
